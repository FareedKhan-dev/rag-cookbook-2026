# =============================================================================
# RAG Cookbook 2026 — provider keys
# Copy to `.env` and fill in only the providers you intend to use.
# Every recipe defaults to PROVIDER=nebius; one cell flips it to anything below.
# =============================================================================

# --- Primary provider ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/

# --- Alternate LLM providers (optional, swap via PROVIDER env var) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# --- Embedding / reranker providers ---
COHERE_API_KEY=
VOYAGE_API_KEY=
JINA_API_KEY=

# --- Tracing & observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-cookbook-2026
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Optional vector-store hosts (defaults are in-memory / embedded) ---
QDRANT_URL=
QDRANT_API_KEY=
PINECONE_API_KEY=

# --- Default behavior ---
PROVIDER=nebius
COOKBOOK_TRACING=phoenix
